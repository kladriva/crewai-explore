# ==============================================
# VPS Monitoring AI - Configuration
# ==============================================

# ============ LLM Configuration ============
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ============ Master Server ============
MASTER_HOST=0.0.0.0
MASTER_PORT=8000
GRPC_PORT=50051
WS_PORT=8001

# ============ Database Configuration ============
# MySQL (Metadata, Audit, Users)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vps_monitoring
MYSQL_USER=monitoring_user
MYSQL_PASSWORD=your_secure_password

# InfluxDB (Time-Series Metrics)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token
INFLUX_ORG=vps-monitoring
INFLUX_BUCKET=metrics

# Redis (Cache & Real-time)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ RabbitMQ ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============ Authentication ============
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ Alerting ============
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=alerts@vps-monitoring.local

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ============ ML Configuration ============
ML_MODEL_PATH=./ml_models
ANOMALY_THRESHOLD=0.7
RETRAIN_INTERVAL_HOURS=24
MIN_TRAINING_SAMPLES=1000

# ============ Monitoring Rules ============
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=85
MEMORY_WARNING_THRESHOLD=75
MEMORY_CRITICAL_THRESHOLD=90
DISK_WARNING_THRESHOLD=80
DISK_CRITICAL_THRESHOLD=95

# Action Safety Limits
MAX_ACTIONS_PER_HOUR=10
ENABLE_AUTO_RESTART=true
ENABLE_CACHE_CLEAR=true
ENABLE_DISK_CLEANUP=true

# ============ Data Retention ============
METRICS_RETENTION_DAYS=7
LOGS_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# ============ Development ============
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
